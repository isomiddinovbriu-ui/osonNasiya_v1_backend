          "productName": { "type": "string" },
          "groupId": { "type": "string", "nullable": true, "description": "Eski yozuvlarda null bo'lishi mumkin" },
          "sectionId": { "type": "string", "nullable": true, "description": "Eski yozuvlarda null bo'lishi mumkin" },
          "productId": { "type": "string", "nullable": true, "description": "Eski yozuvlarda null bo'lishi mumkin" },
          "regionId": { "type": "string" },
          "lat": { "type": "number", "format": "double", "nullable": true, "description": "Eski yozuvlarda null bo'lishi mumkin" },
          "long": { "type": "number", "format": "double", "nullable": true, "description": "Eski yozuvlarda null bo'lishi mumkin" },
          "totalPrice": { "type": "integer" },
          "downPayment": { "type": "integer" },
          "termMonths": { "type": "integer" },
          "totalPaid": { "type": "integer" },
          "remainingBalance": { "type": "integer" },
          "description": { "type": "string" },
          "payments": { "type": "array", "items": { "$ref": "#/components/schemas/Payment" } },
          "createdBy": { "type": "string" },
          "createdByRole": { "type": "string", "enum": ["super_admin", "sotuvchi", "yiguvchi"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CustomerResponse": {
        "type": "object",
        "required": ["customer"],
        "properties": { "customer": { "$ref": "#/components/schemas/Customer" } }
      },
      "AddPaymentRequest": {
        "type": "object",
        "required": ["amount", "method"],
        "properties": {
          "amount": { "type": "integer", "minimum": 1, "description": "So'mda" },
          "method": { "$ref": "#/components/schemas/PaymentMethod" }
        }
      },
      "AddPaymentResponse": {
        "type": "object",
        "required": ["payment", "customer"],
        "properties": {
          "payment": { "$ref": "#/components/schemas/Payment" },
          "customer": { "$ref": "#/components/schemas/Customer" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      }
    }
  }
