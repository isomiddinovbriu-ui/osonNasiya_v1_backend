{
  "openapi": "3.0.3",
  "info": {
    "title": "OsonNasiya API",
    "version": "0.1.0",
    "description": "Mobil ilova API: autentifikatsiya, xodimlar, hududlar, mijozlar va to'lovlar."
  },
  "servers": [{ "url": "/", "description": "Joriy server" }],
  "tags": [
    { "name": "Health", "description": "Server holati" },
    { "name": "Auth", "description": "Foydalanuvchi kirishi" },
    { "name": "Users", "description": "Super-admin xodimlarni boshqarishi, jumladan product_creator" },
    { "name": "Regions", "description": "Hududlar" },
    { "name": "Customers", "description": "Nasiya oluvchi mijozlar" },
    { "name": "Payments", "description": "Mijoz to'lovlari" },
    { "name": "Catalog", "description": "Mahsulot guruhlari, bo'limlari va mahsulotlar" }
  ],
  "paths": {
    "/product-categories": {
      "post": { "tags": ["Catalog"], "summary": "Guruh yoki bo'lim yaratish (product_creator)", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCategoryRequest" } } } }, "responses": { "201": { "description": "Yaratildi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryResponse" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } },
      "get": { "tags": ["Catalog"], "summary": "Guruh va bo'limlar ro'yxati", "description": "parentId=null asosiy guruhlarni, parentId=<id> uning bo'limlarini beradi.", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "parentId", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Ro'yxat", "content": { "application/json": { "schema": { "type": "object", "properties": { "categories": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } } } } } } }
    },
    "/product-categories/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "tags": ["Catalog"], "summary": "Guruh yoki bo'limni olish", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Kategoriya", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryResponse" } } } } } },
      "patch": { "tags": ["Catalog"], "summary": "Guruh yoki bo'lim nomini yangilash (product_creator)", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 100 } } } } } }, "responses": { "200": { "description": "Yangilandi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryResponse" } } } } } },
      "delete": { "tags": ["Catalog"], "summary": "Bo'sh guruh yoki bo'limni o'chirish (product_creator)", "security": [{ "bearerAuth": [] }], "responses": { "204": { "description": "O'chirildi" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/products": {
      "post": { "tags": ["Catalog"], "summary": "Bo'limga mahsulot yaratish (product_creator)", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateProductRequest" } } } }, "responses": { "201": { "description": "Yaratildi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } } } } } },
      "get": { "tags": ["Catalog"], "summary": "Mahsulotlar ro'yxati", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "categoryId", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Ro'yxat", "content": { "application/json": { "schema": { "type": "object", "properties": { "products": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } } } } } } } } }
    },
    "/products/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "tags": ["Catalog"], "summary": "Mahsulotni olish", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Mahsulot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } } } } } },
      "patch": { "tags": ["Catalog"], "summary": "Mahsulotni yangilash (product_creator)", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProductRequest" } } } }, "responses": { "200": { "description": "Yangilandi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } } } } } },
      "delete": { "tags": ["Catalog"], "summary": "Savdoga biriktirilmagan mahsulot va rasmlarini o'chirish (product_creator)", "security": [{ "bearerAuth": [] }], "responses": { "204": { "description": "O'chirildi" }, "409": { "description": "Mahsulot mijoz savdosiga biriktirilgan" } } }
    },
    "/products/{id}/images": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "post": { "tags": ["Catalog"], "summary": "Mahsulotga rasm yuklash (product_creator)", "description": "Jami 10 ta; JPEG, PNG yoki WebP; har biri 5 MB gacha.", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["images"], "properties": { "images": { "type": "array", "maxItems": 10, "items": { "type": "string", "format": "binary" } } } } } } }, "responses": { "201": { "description": "Yuklandi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } } } }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/products/{id}/images/{imageId}": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "imageId", "in": "path", "required": true, "schema": { "type": "string" } }], "delete": { "tags": ["Catalog"], "summary": "Rasmni o'chirish (product_creator)", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "O'chirildi", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } } } } } } },
    "/api/public/files/{publicId}": { "parameters": [{ "name": "publicId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "get": { "tags": ["Catalog"], "summary": "publicId orqali MinIO rasmini olish", "description": "Certification loyihasidagi kabi publicId doimiy, MinIO obyekt nomi ichki ma'lumot.", "responses": { "200": { "description": "Rasm", "content": { "image/jpeg": { "schema": { "type": "string", "format": "binary" } }, "image/png": { "schema": { "type": "string", "format": "binary" } }, "image/webp": { "schema": { "type": "string", "format": "binary" } } } } } } },
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Server ishlayotganini tekshirish",
        "responses": {
          "200": {
            "description": "Server ishlayapti",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/regions/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "tags": ["Regions"],
        "summary": "Bitta hududni olish",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Hudud ma'lumotlari",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegionResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/RegionNotFound" }
        }
      },
      "patch": {
        "tags": ["Regions"],
        "summary": "Hududni yangilash",
        "description": "Super-admin istalgan, sotuvchi o'zi yaratgan hududni yangilaydi.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateRegionRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Hudud yangilandi",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegionResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/RegionNotFound" },
          "409": { "$ref": "#/components/responses/RegionConflict" }
        }
      },
      "delete": {
        "tags": ["Regions"],
        "summary": "Hududni o'chirish",
        "description": "Super-admin istalgan, sotuvchi o'zi yaratgan hududni o'chiradi.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Hudud o'chirildi" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/RegionNotFound" },
          "409": { "$ref": "#/components/responses/RegionInUse" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Foydalanuvchi login",
        "description": "Login kichik harfga o'tkaziladi. JWT 12 soat amal qiladi.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Kirish muvaffaqiyatli",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": {
            "description": "Urinishlar soni oshdi; 15 daqiqadan keyin qayta urinib ko'ring",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Joriy foydalanuvchi",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Joriy foydalanuvchi ma'lumotlari",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/users": {
      "post": {
        "tags": ["Users"],
        "summary": "Yiguvchi, sotuvchi yoki product_creator yaratish",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUserRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Xodim yaratildi",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "get": {
        "tags": ["Users"],
        "summary": "Xodimlar ro'yxati",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Xodimlar ro'yxati",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsersResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/users/{id}": {
      "patch": {
        "tags": ["Users"],
        "summary": "Xodim ma'lumotlarini yangilash",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateUserRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Xodim yangilandi",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/regions": {
      "post": {
        "tags": ["Regions"],
        "summary": "Hudud yaratish",
        "description": "Faqat super_admin va sotuvchi yaratishi mumkin.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRegionRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Hudud yaratildi",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegionResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/RegionConflict" }
        }
      },
      "get": {
        "tags": ["Regions"],
        "summary": "Hududlar ro'yxati",
        "description": "Barcha tizimga kirgan foydalanuvchilar ko'ra oladi.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Hududlar ro'yxati",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegionsResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/customers": {
      "post": {
        "tags": ["Customers"],
        "summary": "Mijoz va nasiya savdosini yaratish",
        "description": "Sotuvchi, yig'uvchi yoki super-admin mijozni hududga va katalogdagi mahsulotga bog'laydi. groupId > sectionId > productId bog'lanishi tekshiriladi. Mijoz joylashuvi lat va long bilan saqlanadi. productName mahsulot nomidan olinadi. Boshlang'ich to'lov shu yozuvda atomik saqlanadi. Summalar butun so'mda.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCustomerRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Mijoz yaratildi",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Hudud, guruh, bo'lim yoki mahsulot topilmadi" }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "tags": ["Customers"],
        "summary": "Mijoz va to'lov tarixini olish",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Mijoz ma'lumotlari",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/CustomerNotFound" }
        }
      }
    },
    "/customers/{id}/payments": {
      "post": {
        "tags": ["Payments"],
        "summary": "Mijozning keyingi to'lovini yozish",
        "description": "To'lov va qoldiq bitta MongoDB hujjatida atomik yangilanadi. Summa qolgan qarzdan oshmasligi kerak.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddPaymentRequest" } } }
        },
        "responses": {
          "201": {
            "description": "To'lov yozildi",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddPaymentResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/CustomerNotFound" },
          "409": { "$ref": "#/components/responses/PaymentConflict" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "responses": {
      "BadRequest": {
        "description": "So'rov noto'g'ri",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Token yo'q, tugagan yoki login/parol noto'g'ri",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "Bu amal uchun rolga ruxsat yo'q",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "Login yoki shu foydalanuvchining paroli allaqachon mavjud",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RegionConflict": {
        "description": "Hudud nomi allaqachon mavjud",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RegionNotFound": {
        "description": "Hudud topilmadi",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RegionInUse": {
        "description": "Hududga mijozlar biriktirilgan",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "CustomerNotFound": {
        "description": "Mijoz topilmadi",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "PaymentConflict": {
        "description": "To'lov qolgan qarzdan katta",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Xodim topilmadi",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "CreateCategoryRequest": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 100, "example": "Texnika" }, "parentId": { "type": "string", "nullable": true, "description": "Texnika IDsi berilsa Telefon kabi bo'lim yaratiladi" } } },
      "Category": { "type": "object", "required": ["id", "name", "parentId", "createdBy", "createdAt"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "parentId": { "type": "string", "nullable": true }, "createdBy": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time", "nullable": true } } },
      "CategoryResponse": { "type": "object", "properties": { "category": { "$ref": "#/components/schemas/Category" } } },
      "CreateProductRequest": { "type": "object", "required": ["name", "title", "categoryId"], "properties": { "name": { "type": "string", "maxLength": 100, "example": "Samsung A55" }, "title": { "type": "string", "maxLength": 200, "example": "Samsung Galaxy A55 256GB" }, "categoryId": { "type": "string", "description": "Bo'lim IDsi" } } },
      "UpdateProductRequest": { "type": "object", "minProperties": 1, "additionalProperties": false, "properties": { "name": { "type": "string", "maxLength": 100 }, "title": { "type": "string", "maxLength": 200 }, "categoryId": { "type": "string" } } },
      "ProductImage": { "type": "object", "properties": { "id": { "type": "string" }, "publicId": { "type": "string", "format": "uuid" }, "url": { "type": "string", "description": "Public fayl URLi; MinIO obyekt nomidan mustaqil" } } },
      "Product": { "type": "object", "required": ["id", "name", "title", "categoryId", "images", "createdBy", "createdAt"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "title": { "type": "string" }, "categoryId": { "type": "string" }, "images": { "type": "array", "maxItems": 10, "items": { "$ref": "#/components/schemas/ProductImage" } }, "createdBy": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time", "nullable": true } } },
      "ProductResponse": { "type": "object", "properties": { "product": { "$ref": "#/components/schemas/Product" } } },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string", "enum": ["ok"] } }
      },
      "User": {
        "type": "object",
        "required": ["id", "login", "role", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "login": { "type": "string" },
          "role": { "type": "string", "enum": ["super_admin", "yiguvchi", "sotuvchi", "product_creator"] },
          "name": { "type": "string", "example": "Ali Valiyev" },
          "description": { "type": "string", "example": "Toshkent filiali" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["login", "password"],
        "properties": {
          "login": { "type": "string", "maxLength": 100, "example": "admin" },
          "password": { "type": "string", "format": "password", "example": "your-password" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["token", "user"],
        "properties": {
          "token": { "type": "string", "description": "12 soatlik JWT" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": ["user"],
        "properties": { "user": { "$ref": "#/components/schemas/User" } }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["login", "password", "role", "name"],
        "properties": {
          "login": { "type": "string", "maxLength": 100, "example": "ali" },
          "password": { "type": "string", "format": "password", "minLength": 5, "maxLength": 5, "pattern": "^[0-9]{5}$", "example": "12345" },
          "role": { "type": "string", "enum": ["yiguvchi", "sotuvchi", "product_creator"] },
          "name": { "type": "string", "maxLength": 100, "example": "Ali Valiyev" },
          "description": { "type": "string", "maxLength": 1000, "example": "Toshkent filiali" }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "login": { "type": "string", "maxLength": 100 },
          "password": { "type": "string", "format": "password", "minLength": 5, "maxLength": 5, "pattern": "^[0-9]{5}$", "example": "54321" },
          "role": { "type": "string", "enum": ["yiguvchi", "sotuvchi", "product_creator"] },
          "name": { "type": "string", "maxLength": 100 },
