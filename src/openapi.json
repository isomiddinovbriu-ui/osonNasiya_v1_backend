        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "createdBy": { "type": "string", "description": "Yaratgan foydalanuvchi IDsi" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
