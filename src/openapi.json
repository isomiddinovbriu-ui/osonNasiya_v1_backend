        "type": "object",
        "required": ["regions"],
        "properties": { "regions": { "type": "array", "items": { "$ref": "#/components/schemas/Region" } } }
      },
      "PaymentMethod": { "type": "string", "enum": ["cash", "card", "transfer"] },
      "CreateCustomerRequest": {
        "type": "object",
        "required": ["name", "phoneNumber", "groupId", "sectionId", "productId", "regionId", "lat", "long", "totalPrice", "downPayment", "termMonths"],
        "properties": {
          "name": { "type": "string", "maxLength": 100, "example": "Ali Valiyev" },
          "phoneNumber": { "type": "string", "example": "+998901234567" },
          "addPhoneNumber": { "type": "string", "nullable": true, "description": "Ixtiyoriy qo'shimcha telefon raqami", "example": "+998901112233" },
          "groupId": { "type": "string", "description": "Asosiy guruh IDsi" },
          "sectionId": { "type": "string", "description": "Shu guruhdagi bo'lim IDsi" },
          "productId": { "type": "string", "description": "Shu bo'limdagi mahsulot IDsi" },
          "regionId": { "type": "string", "description": "Mavjud hudud IDsi" },
          "lat": { "type": "number", "format": "double", "minimum": -90, "maximum": 90, "example": 41.2995 },
          "long": { "type": "number", "format": "double", "minimum": -180, "maximum": 180, "example": 69.2401 },
          "totalPrice": { "type": "integer", "minimum": 1, "description": "Jami narx, so'mda", "example": 3000000 },
          "downPayment": { "type": "integer", "minimum": 0, "description": "Boshlang'ich to'lov, so'mda", "example": 500000 },
          "paymentMethod": { "$ref": "#/components/schemas/PaymentMethod", "description": "downPayment > 0 bo'lsa majburiy" },
          "termMonths": { "type": "integer", "minimum": 1, "maximum": 120, "example": 12 },
          "description": { "type": "string", "maxLength": 1000 }
